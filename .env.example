# HF2S3 - Plantilla de Configuración Opcional (.env)
# --------------------------------------------------------------------------------------
# NOTA IMPORTANTE:
# El archivo .env es 100% OPCIONAL. Todos los parámetros del sistema se pueden configurar,
# modificar y persistir directamente desde la interfaz web (pestaña "Configuración"),
# guardándose de forma permanente en la base de datos SQLite integrada.
# --------------------------------------------------------------------------------------

# Credenciales de Administrador para el Panel Web
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-secure-password-2026

# Credenciales S3 / R2 para clientes externos (Rclone, AWS CLI, etc.)
HF2S3_ACCESS_KEY=hf2s3-access-key
HF2S3_SECRET_KEY=hf2s3-secret-key

# Frase Maestra AES-256-GCM para el Cifrado en Reposo de Datasets Públicos
HF2S3_MASTER_KEY=your-secure-aes-master-passphrase-here

# Tamaño de Chunks para Datasets Públicos en Megabytes (32 MB recomendado)
HF2S3_CHUNK_SIZE_MB=32

# Región S3 Reportada
HF2S3_REGION=us-east-1

# Ruta de Base de Datos SQLite (Persistente en Coolify/Docker: /data/hf2s3_metadata.db)
HF2S3_DB=./hf2s3_metadata.db

# Puerto de Escucha HTTP
PORT=8080

# ------------------------------------------------------------------------------
# Tier 1 (Caché S3 Hugging Face Storage Buckets - s3.hf.co):
# ------------------------------------------------------------------------------
HF_STORAGE_ENDPOINT=https://s3.hf.co
HF_STORAGE_REGION=us-east-1
HF_STORAGE_ACCESS_KEY=
HF_STORAGE_SECRET_KEY=
HF_STORAGE_BUCKET=
