# HF2S3 - configuration template
# --------------------------------------------------------------------------------------
# Generate a complete set of fresh secrets with:   hf2s3 keygen
#
# The gateway REFUSES to start in production with a missing master key, or with
# missing / well-known access keys or admin password. Never reuse values from
# documentation examples.
#
# Values set here (or as real environment variables) take precedence over anything
# stored in the database and become read-only in the web console.
# --------------------------------------------------------------------------------------

# --- Required -------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts every chunk stored on Hugging Face and the tokens
# kept in the database. LOSING IT MEANS LOSING THE DATA: keep an offline copy.
HF2S3_MASTER_KEY=

# Credentials your S3 clients (rclone, AWS CLI, boto3...) sign requests with.
HF2S3_ACCESS_KEY=
HF2S3_SECRET_KEY=

# Web console administrator (password: 12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Public address / reverse proxy ---------------------------------------------------
# External URL of the gateway. Presigned links are signed for this host, so the proxy
# must forward the original Host header unchanged.
HF2S3_PUBLIC_URL=https://s3.example.com
# true when running behind a proxy that sets X-Forwarded-For/-Proto (Coolify, Traefik...)
HF2S3_TRUST_PROXY=true

# --- Upgrading from an older release --------------------------------------------------
# Comma-separated old master-key passphrases, only needed to read data written before
# the key format changed when the old key is NOT already stored in the database.
# HF2S3_LEGACY_MASTER_KEYS=

# --- Behaviour ------------------------------------------------------------------------
HF2S3_DB=./hf2s3_metadata.db
PORT=8080
HF2S3_CHUNK_SIZE_MB=32
HF2S3_REGION=us-east-1

# auto: 302 to the cache bucket only for presigned URLs (browsers, <video>, /media);
#       SDK/rclone requests signed by header are proxied.  always | never also allowed.
S3_GET_REDIRECT=auto

# Browser origins allowed to call the S3 API (comma separated, or *). Empty = none.
HF2S3_CORS_ORIGINS=

# Largest object promoted to the cache tier, in MB.
HF2S3_CACHE_MAX_OBJECT_MB=5120

# --- Operations -----------------------------------------------------------------------
# Enables /metrics (Prometheus) protected by this bearer token. Empty = disabled.
HF2S3_METRICS_TOKEN=
HF2S3_LOG_FORMAT=json
HF2S3_LOG_LEVEL=info
HF2S3_SHUTDOWN_TIMEOUT_SECONDS=30

# Database snapshots: every N hours (0 disables), keeping the newest N.
# Default directory: <database directory>/backups. An encrypted copy is also uploaded to
# the cache bucket when one is configured.
HF2S3_BACKUP_INTERVAL_HOURS=24
HF2S3_BACKUP_KEEP=7
# HF2S3_BACKUP_DIR=/data/backups

# Largest backup (MB) accepted by the console restore (Settings -> Restore).
HF2S3_RESTORE_MAX_MB=1024

# --- Tier 1 cache bucket (optional; more can be added in the console) --------------------
HF_STORAGE_ENDPOINT=https://s3.hf.co
HF_STORAGE_REGION=us-east-1
HF_STORAGE_ACCESS_KEY=
HF_STORAGE_SECRET_KEY=
HF_STORAGE_BUCKET=

# --- Development only -------------------------------------------------------------------
# HF2S3_DEV=1 allows insecure defaults so you can try the gateway locally. Never in production.
# HF2S3_DEV=
