# HF2S3 - Environment Configuration Template
# Copy this file to .env and configure your values

# Web Dashboard Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-secure-password-2026

# S3 / R2 Gateway Credentials
HF2S3_ACCESS_KEY=hf2s3-access-key
HF2S3_SECRET_KEY=hf2s3-secret-key

# AES-256-GCM Master Key (Crucial: Keep safe, required to decrypt all chunks)
HF2S3_MASTER_KEY=your-secure-aes-master-passphrase-here

# SQLite Metadata Database Path (Use persistent volume in Docker/Coolify: /data/hf2s3_metadata.db)
HF2S3_DB=./hf2s3_metadata.db

# Chunk Size in Megabytes (32 MB recommended)
HF2S3_CHUNK_SIZE_MB=32

# S3 Region
HF2S3_REGION=us-east-1

# HTTP Server Port
PORT=8080
